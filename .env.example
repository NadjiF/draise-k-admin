# Copier ce fichier en .env (non commité) et remplacer les valeurs :
#   cp .env.example .env

# Base PostgreSQL (lue par docker-compose.yml)
POSTGRES_USER=draisek
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=draisek_admin
# Port de la machine sur lequel la base est accessible
POSTGRES_PORT=5432
# Machine où tourne la base, vue depuis l'API
POSTGRES_HOST=localhost
# Port de la base de test (service db-test, utilisé par npm test)
POSTGRES_TEST_PORT=5433

# API
API_PORT=3000

# Administrateur unique du back-office
ADMIN_IDENTIFIANT=admin
# Hash du mot de passe (jamais le mot de passe en clair), généré par :
#   cd api && npm run hash-mot-de-passe
# Garder les apostrophes : le hash contient des $, que docker compose
# interpréterait sinon comme des noms de variables.
ADMIN_MOT_DE_PASSE_HASH='$argon2id$a-remplacer'

# Secret de signature des jetons JWT (au moins 32 caractères), généré par :
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
JWT_SECRET=a-remplacer
